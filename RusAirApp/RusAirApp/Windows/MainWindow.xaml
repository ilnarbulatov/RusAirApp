<Window x:Class="RusAirApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RusAirApp"
        mc:Ignorable="d"
        Title="RusAir" Height="1024" Width="1080" 
        Background="Transparent"
        Style="{StaticResource base_window}"
        WindowStartupLocation="CenterScreen">



    <Grid MouseDown="Grid_MouseDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="145"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        
            <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" Grid.ColumnSpan="4">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,1"
                                     EndPoint="1,1">
                    <GradientStop Color="#d6a3ff"
                                  Offset="0.1"/>
                    <GradientStop Color="#00ffcc"
                                  Offset="2"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        
        <TextBlock Style="{StaticResource base_tblock}" Grid.Row="1" Text="Поиск дёшевых авиабилетов"
                   Margin="10" FontSize="40"/>
        <TextBlock Style="{StaticResource base_tblock}" Grid.Row="1" Text="помогаем экономить"
                   Margin="60" FontSize="25"/>
        
        <Button Name="BtnLog" Margin="0 0 150 0" Width="40" Height="40" Click="BtnLog_Click" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" BorderBrush="Transparent" Background="#01000000">
            <Image Source="/Resources/ico.png" Height="25" Width="25"></Image>
        </Button>
        <Button Name="BtnExit" Margin="0 0 60 0" Width="40" Height="40" Click="BtnExit_Click" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" BorderBrush="Transparent" Background="#01000000">
            <Image Source="/Resources/ico1.png" Height="25" Width="25"></Image>
        </Button>


        <TextBlock Style="{StaticResource other_tblock}" Text="Профиль"
                   Margin="0 15 105 0" FontSize="10" Grid.Row="0"/>
        <TextBlock Style="{StaticResource other_tblock}" Text="Выход"
                   Margin="0 15 30 0" FontSize="10" Grid.Row="0"/>
        <TextBlock Style="{StaticResource other_tblock}" Text="RusAir"
                   Margin="60 15 15 0" HorizontalAlignment="Left"
                   FontSize="25" Grid.Row="0"/>
        
        <Image Source="/Resources/RusAirIcoNew.png" HorizontalAlignment="Left" Margin="15 0 0 0" Height="40" Width="40"/>
        <TextBox Text="TestText" Grid.Row="2" Style="{StaticResource base_tbox}" Margin="0 30 600 0">
            <TextBox.Template>
                <ControlTemplate>
                    <Border CornerRadius="12 0 0 12" Padding="15" BorderThickness="1" BorderBrush="#705BE3" Background="White" Height="50" Width="100">
                        <ScrollViewer Margin="0" x:Name="PART_ContentHost" />
                    </Border>
                </ControlTemplate>
            </TextBox.Template>
        </TextBox>
        <TextBox Text="TestText" Grid.Row="2" Style="{StaticResource base_tbox}" Margin="0 30 390 0">
            <TextBox.Template>
                <ControlTemplate>
                    <Border CornerRadius="0" Padding="15" BorderThickness="1" BorderBrush="#705BE3"
                            Background="White" Height="50" Width="100">
                        <ScrollViewer Margin="0" x:Name="PART_ContentHost" />
                    </Border>
                </ControlTemplate>
            </TextBox.Template>
        </TextBox>
        <TextBox Text="TestText" Grid.Row="2" Style="{StaticResource base_tbox}" Margin="0 30 180 0">
            <TextBox.Template>
                <ControlTemplate>
                    <Border CornerRadius="0" Padding="15" BorderThickness="1" BorderBrush="#705BE3"
                            Background="White" Height="50" Width="100">
                        <ScrollViewer Margin="0" x:Name="PART_ContentHost" />
                    </Border>
                </ControlTemplate>
            </TextBox.Template>
        </TextBox>
        <TextBox Text="TestText" Grid.Row="2" Style="{StaticResource base_tbox}" Margin="0 30 -30 0">
            <TextBox.Template>
                <ControlTemplate>
                    <Border CornerRadius="0" Padding="15" BorderThickness="1" BorderBrush="#705BE3"
                            Background="White" Height="50" Width="100">
                        <ScrollViewer Margin="0" x:Name="PART_ContentHost" />
                    </Border>
                </ControlTemplate>
            </TextBox.Template>
        </TextBox>
        <TextBox Text="TestText" Grid.Row="2" Style="{StaticResource base_tbox}" Margin="0 30 -240 0">
            <TextBox.Template>
                <ControlTemplate>
                    <Border CornerRadius="0 12 12 0" Padding="15" BorderThickness="1" 
                            BorderBrush="#705BE3" Background="White" Height="50" Width="100">
                        <ScrollViewer Margin="0" x:Name="PART_ContentHost" />
                    </Border>
                </ControlTemplate>
            </TextBox.Template>
        </TextBox>
        <Button x:Name="BtnFind" Content="Найти" IsDefault="True" HorizontalAlignment="Center" VerticalAlignment="Top" Click="BtnFind_Click" Grid.Row="2" Height="45" Width="160" Foreground="White"
                FontWeight="Bold" FontFamily="Arial"
                BorderBrush="White" Background="#677ABB"
                Margin="0 32 -510 0"/>
    </Grid>
</Window>
